# Ejemplo local ÚNICAMENTE. Copiar a .env (no versionar .env) y cambiar valores.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/liftmanager
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-this-local-password
APP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
APP_BOOTSTRAP_ADMIN_EMAIL=admin@liftmanager.local
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-12-or-more-characters
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
TZ=America/Argentina/Buenos_Aires
